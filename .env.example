# BUDDILANE PREMIER LEAGUE — SEASON 3 (2026–27)
# MilesWeb MariaDB Hosting Environment Configuration
# Copy this file to .env and adjust values for your environment

# MilesWeb MariaDB Production Settings
DB_TYPE=mysql
DB_NAME=mubix_in1_bpl_season3
DB_USER=mubix_in1_bpluser
DB_PASS=YOUR_ACTUAL_MARIADB_PASSWORD_HERE
DB_SOCKET=/run/mysqld/mysqld.sock
DB_HOST=103.108.220.222
DB_PORT=3306

# Razorpay Payment Gateway Credentials
# Replace with your actual credentials from Razorpay Dashboard (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Allow SQLite fallback for local CLI unit testing (true/false)
ALLOW_SQLITE_FALLBACK=true
