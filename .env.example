# BUDDILANE PREMIER LEAGUE — ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust values for your environment

# Database Configuration (MySQL)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=buddilane_db
DB_USER=root
DB_PASS=

# Razorpay Payment Gateway Credentials
# Replace with your actual credentials from Razorpay Dashboard (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Allow SQLite fallback for CLI unit testing without running MySQL server (true/false)
ALLOW_SQLITE_FALLBACK=false

