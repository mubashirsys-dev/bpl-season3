{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/api/create-order.php",
      "dest": "/api/create-order.php"
    },
    {
      "src": "/api/verify-payment.php",
      "dest": "/api/verify-payment.php"
    },
    {
      "src": "/api/check-payment-status.php",
      "dest": "/api/check-payment-status.php"
    },
    {
      "src": "/api/razorpay-webhook.php",
      "dest": "/api/razorpay-webhook.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
